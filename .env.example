# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=ssibuchat
# Required to bootstrap first independent admin. Generate a long random value.
SSIBUCHAT_BOOTSTRAP_SECRET=
# Separate random session pepper.
# Dedicated encryption key for MFA TOTP secrets; use a unique random value per deployment (32+ chars).
SSIBUCHAT_MFA_ENCRYPTION_KEY=
SSIBUCHAT_SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
# Optional AI provider. Configure only in the independent Vercel project after explicit consent UX and provider privacy review.
SSIBUCHAT_AI_BASE_URL=https://api.openai.com/v1
SSIBUCHAT_AI_API_KEY=
SSIBUCHAT_AI_MODEL=
# Configure other provider credentials only in the independent Vercel project.
# SMS_WEBHOOK_SECRET=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# AES-256-GCM key for the independent MAC configuration vault (32 random bytes, base64 encoded).
SSIBUCHAT_CONFIG_ENCRYPTION_KEY=
# Outbox worker bearer secret; set the same value in independent Vercel Production and GitHub Actions CRON_SECRET.
CRON_SECRET=

# Resend transactional email adapter (required for verification and password recovery).
RESEND_API_KEY=
SSIBUCHAT_EMAIL_FROM=
SSIBUCHAT_APP_URL=

# Commerce payment mode: disabled by default; sandbox is for non-production testing only.
SSIBUCHAT_PAYMENT_MODE=disabled
SSIBUCHAT_ALLOW_SANDBOX_SETTLEMENT=false

# Private media storage (S3-compatible, e.g. AWS S3 or Cloudflare R2).
SSIBUCHAT_S3_ENDPOINT=
SSIBUCHAT_S3_REGION=auto
SSIBUCHAT_S3_BUCKET=
SSIBUCHAT_S3_ACCESS_KEY_ID=
SSIBUCHAT_S3_SECRET_ACCESS_KEY=
SSIBUCHAT_S3_SESSION_TOKEN=
# Malware scanner: leave unset to keep uploads pending_scan and unavailable.
SSIBUCHAT_MEDIA_SCAN_URL=
SSIBUCHAT_MEDIA_SCAN_TOKEN=

# Optional ICE server configuration for the WebRTC client (JSON array).
VITE_SSIBUCHAT_ICE_SERVERS_JSON=[]

# Authenticated cron/worker endpoint for durable outbox dispatch.
SSIBUCHAT_WORKER_SECRET=
